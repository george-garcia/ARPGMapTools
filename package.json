{
  "name": "arpg-map-tools",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that drives Azgaar's Fantasy Map Generator to build the ARPG world map",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "setup": "node scripts/setup-azgaar.mjs",
    "build": "tsc -p tools/azgaar-mcp",
    "start": "node tools/azgaar-mcp/dist/index.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright": "1.63.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
